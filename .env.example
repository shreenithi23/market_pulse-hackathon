# Server Port (Default: 3000)
PORT=3000

# Environment Mode (development | production)
NODE_ENV=development

# Optional: Google Gemini API Key for AI Executive Briefings & Intelligence Synthesis
# If left blank, the app will run with pre-computed smart heuristic briefings
GEMINI_API_KEY=

# Optional: CORS allowed origins (comma-separated, default: all allowed in dev)
# CORS_ORIGIN=http://localhost:3000
